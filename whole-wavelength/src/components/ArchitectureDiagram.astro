---
interface Props { kind: string; compact?: boolean; }
const { kind, compact = false } = Astro.props;
const labels: Record<string, string> = { zoom: 'Vom Gesamtsystem in eine einzelne Anwendung hineinzoomen', petclinic: 'Owner besitzt Pet, Pet hat Visits, Vet behandelt Tiere', monolith: 'Eine PetClinic mit gemeinsamer Deployment-Grenze', modular: 'Owner, Vet und System als Module in einer Anwendung', microservices: 'Gateway verbindet getrennt deploybare Services', scs: 'Autonome Systeme mit eigener UI, Logik und Daten', visit: 'Visit erfassen: vom Request zur Persistenz', layered: 'Presentation, Application und Data Access', clean: 'Entities, Use Cases, Adapter und Frameworks', hexagonal: 'Anwendungskern, Ports und externe Adapter', onion: 'Domain Model im Zentrum, Infrastruktur aussen', compare: 'Systemgrenzen und Code-Struktur sind kombinierbar' };
---
<figure class:list={['architecture-figure', { compact }]}>
  <div class="figure-top"><span class="figure-dot"></span><span>DAS ARCHITEKTURBILD</span><span class="figure-tag">PETCLINIC</span></div>
  <svg viewBox="0 0 760 370" role="img" aria-label={labels[kind] || labels.zoom} class="architecture-svg">
    <defs><marker id={`arrow-${kind}`} markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto"><path d="M0 0L6 3L0 6" fill="none" stroke="currentColor" stroke-width="1.3" /></marker><pattern id={`grid-${kind}`} width="22" height="22" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r=".8" fill="#cbd4ce" /></pattern></defs>
    <rect width="760" height="370" fill={`url(#grid-${kind})`} opacity=".5" />
    {(kind === 'monolith' || kind === 'modular') && <>
      <text x="380" y="38" text-anchor="middle" class="svg-small">EINE ANWENDUNG · EIN PROZESS</text><rect x="130" y="64" width="500" height="220" rx="14" class="svg-boundary" /><text x="154" y="94" class="svg-label">Spring PetClinic</text>
      {kind === 'monolith' ? <>{['Owner', 'Pet', 'Visit', 'Vet'].map((name, i) => <g class="svg-hover"><title>{name} bleibt innerhalb derselben Anwendungsgrenze.</title><rect x={155 + i * 114} y="134" width="102" height="70" rx="7" class={i === 2 ? 'svg-accent' : 'svg-box'} /><text x={206 + i * 114} y="175" text-anchor="middle" class="svg-label">{name}</text></g>)}</> : <>
        <rect x="153" y="116" width="250" height="103" rx="8" class="svg-accent" /><text x="174" y="144" class="svg-label">owner</text><text x="174" y="177" class="svg-small">Owner · Pet · Visit</text><rect x="443" y="116" width="161" height="103" rx="8" class="svg-box" /><text x="464" y="144" class="svg-label">vet</text><text x="464" y="177" class="svg-small">Veterinarians</text><path d="M404 166H440" class="svg-line" marker-end={`url(#arrow-${kind})`} /><text x="423" y="238" text-anchor="middle" class="svg-small">definierte API / Event</text><text x="174" y="261" class="svg-small">system · gemeinsame technische Funktionen</text>
      </>}
      <path d="M380 285V316" class="svg-line" marker-end={`url(#arrow-${kind})`} /><rect x="300" y="321" width="160" height="32" rx="6" class="svg-box" /><text x="380" y="342" text-anchor="middle" class="svg-small">Datenbank</text>
    </>}
    {kind === 'microservices' && <>
      <text x="380" y="33" text-anchor="middle" class="svg-small">BROWSER</text><path d="M380 42V66" class="svg-line" marker-end={`url(#arrow-${kind})`} /><rect x="290" y="72" width="180" height="52" rx="8" class="svg-box" /><text x="380" y="103" text-anchor="middle" class="svg-label">API Gateway</text><path d="M380 125V151H150V181M380 151V181M380 151H610V181" class="svg-line" marker-end={`url(#arrow-${kind})`} />
      {['Customers', 'Visits', 'Vets'].map((name, i) => <g><rect x={48 + i * 230} y="188" width="205" height="93" rx="10" class={i === 1 ? 'svg-accent' : 'svg-box'} /><text x={150 + i * 230} y="224" text-anchor="middle" class="svg-label">{name} Service</text><text x={150 + i * 230} y="252" text-anchor="middle" class="svg-small">eigenes Deployment</text></g>)}<text x="380" y="326" text-anchor="middle" class="svg-small">Zwischen Services liegen Prozess- und Netzwerkgrenzen.</text>
    </>}
    {kind === 'scs' && <>
      {['Patientenverwaltung', 'Veterinärverwaltung'].map((name, i) => <g><rect x={48 + i * 385} y="45" width="278" height="268" rx="12" class="svg-boundary" /><text x={70 + i * 385} y="80" class="svg-label">{name}</text>{['Eigene Weboberfläche', i === 0 ? 'Owner · Pet · Visit' : 'Vet · Specialties', 'Eigene Datenhaltung'].map((layer, j) => <g><rect x={69 + i * 385} y={103 + j * 65} width="236" height="49" rx="6" class={j === 1 ? 'svg-accent' : 'svg-box'} /><text x={187 + i * 385} y={133 + j * 65} text-anchor="middle" class="svg-small">{layer}</text></g>)}</g>)}<path d="M329 180H428" class="svg-line dashed" marker-end={`url(#arrow-${kind})`} /><text x="380" y="158" text-anchor="middle" class="svg-small">Event</text><text x="380" y="348" text-anchor="middle" class="svg-small">Konzeptioneller Entwurf · keine offizielle PetClinic-Variante</text>
    </>}
    {(kind === 'clean' || kind === 'onion') && <>
      <rect x="103" y="28" width="554" height="310" rx="140" class="svg-ring outer" /><rect x="164" y="86" width="432" height="226" rx="104" class="svg-ring middle" /><rect x="223" y="145" width="314" height="144" rx="70" class="svg-ring inner" /><rect x="282" y="204" width="196" height="62" rx="30" class="svg-accent" /><text x="380" y="60" text-anchor="middle" class="svg-small">{kind === 'clean' ? 'FRAMEWORKS & DRIVERS' : 'UI & INFRASTRUCTURE'}</text><text x="380" y="119" text-anchor="middle" class="svg-small">{kind === 'clean' ? 'INTERFACE ADAPTERS' : 'APPLICATION CORE'}</text><text x="380" y="178" text-anchor="middle" class="svg-small">{kind === 'clean' ? 'USE CASES' : 'DOMAIN SERVICES / CONTRACTS'}</text><text x="380" y="241" text-anchor="middle" class="svg-label">Owner · Pet · Visit</text><path d="M610 90L510 197" class="svg-line" marker-end={`url(#arrow-${kind})`} /><text x="676" y="166" text-anchor="middle" class="svg-small" transform="rotate(90 676 166)">Abhängigkeiten nach innen</text>
    </>}
    {kind === 'hexagonal' && <>
      <path d="M290 52H470L554 185L470 318H290L206 185Z" class="svg-boundary" /><text x="380" y="127" text-anchor="middle" class="svg-small">APPLICATION CORE</text><rect x="280" y="155" width="200" height="58" rx="8" class="svg-accent" /><text x="380" y="190" text-anchor="middle" class="svg-label">BookVisitService</text><text x="380" y="252" text-anchor="middle" class="svg-small">Owner · Pet · Visit</text><rect x="20" y="157" width="143" height="56" rx="8" class="svg-box" /><text x="91" y="190" text-anchor="middle" class="svg-small">Web Adapter</text><path d="M164 185H264M596 185H495" class="svg-line" marker-end={`url(#arrow-${kind})`} /><circle cx="219" cy="185" r="8" class="svg-port" /><circle cx="540" cy="185" r="8" class="svg-port" /><text x="202" y="148" text-anchor="middle" class="svg-small">Input Port</text><text x="559" y="148" text-anchor="middle" class="svg-small">Output Port</text><rect x="597" y="157" width="143" height="56" rx="8" class="svg-box" /><text x="668" y="181" text-anchor="middle" class="svg-small">Persistence</text><text x="668" y="200" text-anchor="middle" class="svg-small">Adapter</text><text x="380" y="353" text-anchor="middle" class="svg-small">Code-Abhängigkeiten: Adapter → Verträge des Kerns</text>
    </>}
    {(kind === 'layered' || kind === 'visit') && <>
      {(kind === 'layered' ? ['Presentation · VisitController', 'Application · BookVisitService', 'Data Access · OwnerRepository', 'Datenbank'] : ['HTTP · Visit-Daten', 'VisitController', 'Owner · Pet · Visit', 'OwnerRepository → Datenbank']).map((name, i) => <g><rect x="175" y={24 + i * 86} width="410" height="58" rx="9" class={i === 1 ? 'svg-accent' : 'svg-box'} /><text x="380" y={59 + i * 86} text-anchor="middle" class="svg-label">{name}</text>{i < 3 && <path d={`M380 ${83 + i * 86}V${100 + i * 86}`} class="svg-line" marker-end={`url(#arrow-${kind})`} />}</g>)}
    </>}
    {kind === 'petclinic' && <>
      {['Owner', 'Pet', 'Visit'].map((name, i) => <g><rect x={45 + i * 249} y="87" width="174" height="86" rx="10" class={i === 2 ? 'svg-accent' : 'svg-box'} /><text x={132 + i * 249} y="138" text-anchor="middle" class="svg-label">{name}</text>{i < 2 && <path d={`M${223 + i * 249} 130h66`} class="svg-line" marker-end={`url(#arrow-${kind})`} />}</g>)}<text x="257" y="106" text-anchor="middle" class="svg-small">besitzt</text><text x="507" y="106" text-anchor="middle" class="svg-small">hat</text><rect x="292" y="245" width="176" height="66" rx="10" class="svg-box" /><text x="380" y="284" text-anchor="middle" class="svg-label">Vet</text><path d="M380 243V184" class="svg-line dashed" marker-end={`url(#arrow-${kind})`} /><text x="465" y="216" text-anchor="middle" class="svg-small">behandelt Tiere</text><text x="380" y="350" text-anchor="middle" class="svg-small">Fachlicher Zusammenhang · kein Datenbank-Klassendiagramm</text>
    </>}
    {(kind === 'zoom' || kind === 'compare') && <>
      <text x="200" y="39" text-anchor="middle" class="svg-small">SYSTEMEBENE</text><text x="575" y="39" text-anchor="middle" class="svg-small">CODEEBENE</text><rect x="36" y="65" width="327" height="242" rx="12" class="svg-boundary" /><text x="61" y="99" class="svg-label">Das Gesamtsystem</text>{['Monolith', 'Modular Monolith', 'Microservices', 'Self-contained Systems'].map((s, i) => <g><rect x="61" y={117 + i * 42} width="277" height="32" rx="5" class={i === 1 ? 'svg-accent' : 'svg-box'} /><text x="80" y={139 + i * 42} class="svg-small">{s}</text></g>)}<path d="M373 185H412" class="svg-line" marker-end={`url(#arrow-${kind})`} /><rect x="426" y="65" width="297" height="242" rx="12" class="svg-boundary" /><text x="451" y="99" class="svg-label">Eine Anwendung / ein Service</text>{['Layered', 'Clean', 'Hexagonal', 'Onion'].map((s, i) => <g><rect x="451" y={117 + i * 42} width="247" height="32" rx="5" class={i === 2 ? 'svg-accent' : 'svg-box'} /><text x="470" y={139 + i * 42} class="svg-small">{s}</text></g>)}<text x="380" y="348" text-anchor="middle" class="svg-small">Deployment-Grenzen und interne Code-Struktur sind kombinierbar.</text>
    </>}
  </svg><figcaption>{labels[kind] || labels.zoom}. Vereinfachte didaktische Darstellung.</figcaption>
</figure>
