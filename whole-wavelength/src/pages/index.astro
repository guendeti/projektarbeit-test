---
import SiteLayout from '../layouts/SiteLayout.astro';
import { chapters, url } from '../data/site';
---
<SiteLayout title="Softwarearchitektur verstehen" active="home">
  <div class="home-page">
    <header class="welcome-intro">
      <h1>Softwarearchitektur verstehen</h1>
      <p>Wie wird eine Anwendung aufgeteilt? Und wie organisiert man den Code darin? Diese Microsite erklärt die wichtigsten Architekturansätze am Beispiel der Spring PetClinic.</p>
      <p>Wir betrachten immer dieselbe Fachlichkeit: <strong>einen Visit für ein Pet erfassen.</strong> So kannst du nachvollziehen, was sich durch die Architektur verändert.</p>
    </header>
    <section class="learning-section" aria-labelledby="learning-path-title">
      <h2 id="learning-path-title">Dein Weg durch die Architektur</h2>
      <ol class="learning-path">
        {chapters.map(chapter => <li><h3><a href={url(`lernen/${chapter.items[0].slug}/`)}>{chapter.title}</a></h3><p>{chapter.description}</p></li>)}
      </ol>
    </section>
  </div>
</SiteLayout>
