---
import SiteLayout from '../layouts/SiteLayout.astro';
import { chapters, url } from '../data/site';
---
<SiteLayout title="Softwarearchitektur verstehen" active="home">
  <div class="home-page">
    <header class="welcome-intro">
      <h1>Softwarearchitektur verstehen – mit Spring PetClinic</h1>
      <p>Wie strukturiert man eine Softwareanwendung? Diese Microsite erklärt grundlegende Architekturansätze am Beispiel einer Tierarztpraxis: der <strong>Spring PetClinic</strong>.</p>
      <p>Die <strong>Systemebene</strong> betrachtet Module, eigenständige Systeme und deren Betrieb. Die <strong>Codeebene</strong> untersucht Verantwortlichkeiten und Abhängigkeiten innerhalb einer Anwendung. Dort vergleichen wir immer denselben Use-Case: <strong>Einen Besuch für ein Haustier erfassen.</strong></p>
      <p>Für Informatikstudierende und Softwareentwickler mit Grundkenntnissen in objektorientierter Programmierung und Webanwendungen.</p>
    </header>
    <section class="learning-section" aria-labelledby="learning-path-title">
      <h2 id="learning-path-title">Dein Weg durch die Architektur</h2>
      <ol class="learning-path">
        {chapters.map(chapter => <li><h3><a href={url(`lernen/${chapter.items[0].slug}/`)}>{chapter.title}</a></h3><p>{chapter.description}</p></li>)}
      </ol>
    </section>
  </div>
</SiteLayout>
